  <Target Name="FirmaECopiaNeiPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildProjectDirectory)\..\..\..\WinGabriel\WinGabriel\bin\Debug') And Exists('$(MSBuildProjectDirectory)\..\..\..\WGStrumenti\WGStrumenti\bin\Debug\WGStrumenti.exe')">
