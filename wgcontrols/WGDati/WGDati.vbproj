  <ItemGroup>
    <Content Include="..\packages\SQLitePCLRaw.lib.e_sqlite3.3.53.3\runtimes\win-x86\native\e_sqlite3.dll">
      <Link>runtimes\win-x86\native\e_sqlite3.dll</Link>
