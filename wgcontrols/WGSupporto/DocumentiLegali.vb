Public Class VisualizzatoreDocumentoLegale
    Private ReadOnly log As New Logger()
    Private lista As WGMenuLista
    Private campoSezione As WGCampo
    Private sezioni As New List(Of SezioneDocumentoLegale)

    Public Sub MostraCondizioniUso()
        Try
            Mostra("Condizioni d'uso di WinGabriel", DocumentiLegaliWinGabriel.ArticoliCondizioniUso())
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.MostraCondizioniUso: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Public Sub MostraPrivacyPolicy()
        Try
            Mostra("Privacy policy di WinGabriel", DocumentiLegaliWinGabriel.SezioniPrivacyPolicy())
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.MostraPrivacyPolicy: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Private Sub Mostra(titolo As String, elencoSezioni As List(Of SezioneDocumentoLegale))
        Try
            sezioni = If(elencoSezioni, New List(Of SezioneDocumentoLegale))

            lista = New WGMenuLista()
            lista.multiselezioneConsentita = False
            lista.impostaTitolo(titolo)
            For indice As Integer = 0 To sezioni.Count - 1
                lista.aggiungiElemento(sezioni(indice).Titolo, indice.ToString())
            Next
            AddHandler lista.ElementoSelezionato, AddressOf SezioneSelezionata
            AddHandler lista.escPremuto, AddressOf EscPremutoLista
            lista.avvia()
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.Mostra: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Private Sub SezioneSelezionata()
        Try
            If lista Is Nothing Then Return
            Dim elementi As List(Of String) = lista.ottieniElementi()
            If elementi Is Nothing OrElse elementi.Count = 0 Then Return
            Dim elemento As String = elementi(0)
            Dim indice As Integer
            If Not Integer.TryParse(elemento, indice) Then Return
            If indice < 0 OrElse indice >= sezioni.Count Then Return

            ChiudiCampoSezione()
            campoSezione = New WGCampo()
            campoSezione.CaricaHtml(sezioni(indice).Titolo, sezioni(indice).Html)
            AddHandler campoSezione.chiusura, AddressOf ChiusuraCampoSezione
            campoSezione.avvia()
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.SezioneSelezionata: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Private Sub ChiusuraCampoSezione(sender As Object, e As EventArgs)
        Try
            If campoSezione IsNot Nothing Then
                RemoveHandler campoSezione.chiusura, AddressOf ChiusuraCampoSezione
                campoSezione = Nothing
            End If
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.ChiusuraCampoSezione: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Private Sub ChiudiCampoSezione()
        Try
            If campoSezione Is Nothing Then Return
            RemoveHandler campoSezione.chiusura, AddressOf ChiusuraCampoSezione
            campoSezione.chiudi()
            campoSezione = Nothing
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.ChiudiCampoSezione: " & ex.Message & Environment.NewLine & ex.StackTrace)
            campoSezione = Nothing
        End Try
    End Sub

    Private Sub EscPremutoLista(sender As Object, e As EventArgs)
        Try
            AbbandonaLista()
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.EscPremutoLista: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub

    Private Sub AbbandonaLista()
        Try
            If lista Is Nothing Then Return
            RemoveHandler lista.escPremuto, AddressOf EscPremutoLista
            lista.abbandona()
            lista = Nothing
        Catch ex As Exception
            log.ScriviLog("VisualizzatoreDocumentoLegale.AbbandonaLista: " & ex.Message & Environment.NewLine & ex.StackTrace)
            lista = Nothing
        End Try
    End Sub
End Class