' Visualizzazione delle condizioni d'uso e dell'informativa sulla privacy. Gestisce la navigazione tra le sezioni dei documenti.
Public Class SezioneDocumentoLegale
    Public Property Titolo As String
    Public Property Html As String

    Public Sub New(titolo As String, html As String)
        Try
            Me.Titolo = titolo
            Me.Html = html
        Catch ex As Exception
            Dim registro As New Logger()
            registro.ScriviLog("SezioneDocumentoLegale.New: " & ex.Message & Environment.NewLine & ex.StackTrace)
        End Try
    End Sub
End Class

