            sezioni.Add(New SezioneDocumentoLegale("Articolo 5 – Limitazioni e divieti", "<ol><li>Fatte salve le facoltà concesse dalla Licenza per sole finalità non commerciali, è fatto espresso divieto all'Utente di: <ul><li>vendere, concedere in locazione, in prestito a titolo oneroso o in sublicenza commerciale il Software o le relative opere derivate;</li><li>includere il Software o parti di esso in programmi, pacchetti, raccolte di software o prodotti hardware a pagamento, anche qualora il Software vi sia presentato come gratuito;</li><li>richiedere corrispettivi per la copia, la distribuzione o l'installazione del Software o delle relative opere derivate;</li><li>rimuovere, alterare od occultare la dicitura obbligatoria «Required Notice: Copyright Gabriel Pappalardo (https://www.wingabriel.net)», le note di copyright o i riferimenti alla Licenza;</li><li>utilizzare il nome o i marchi WinGabriel per contraddistinguere prodotti, servizi o versioni derivate non autorizzate dall'Autore.</li></ul></li><li>È consentito richiedere un compenso esclusivamente per servizi di assistenza tecnica, a condizione che tale compenso non riguardi la fornitura o la distribuzione del Software.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 6 – Diritti inderogabili dell'Utente", "<ol><li>Le disposizioni delle presenti Condizioni e della Licenza non pregiudicano i diritti inderogabili riconosciuti all'utente legittimo dagli articoli 64-ter e 64-quater della Legge 22 aprile 1941, n. 633, entro i limiti e alle condizioni ivi stabiliti.</li><li>Le informazioni ottenute mediante l'esercizio di tali diritti non possono essere utilizzate per scopi diversi da quelli consentiti dalla legge o in violazione dei termini della Licenza.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 7 – Distribuzione e autorizzazioni", "<ol><li>I file eseguibili ufficiali del Software sono distribuiti unicamente tramite i Siti ufficiali e i rilasci del Repository ufficiale.</li><li>La ridistribuzione del codice sorgente o di versioni modificate è consentita nel rispetto dei termini della Licenza, mantenendo inalterata la nota d'avviso obbligatoria e il testo della Licenza stessa.</li><li>La pubblicazione o la distribuzione di versioni modificate o derivate destinate al pubblico richiede il rispetto delle medesime condizioni non commerciali. Qualsiasi canale di distribuzione a carattere commerciale richiede la preventiva autorizzazione scritta dell'Autore.</li><li>Le richieste di autorizzazione in deroga devono essere inviate all'indirizzo indicato all'articolo 1. L'autorizzazione è valida solo se rilasciata per iscritto dall'Autore ed è revocabile in caso di inosservanza delle prescrizioni impartite.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 8 – Componenti e contenuti di terzi", "<ol><li>Il Software contiene librerie e componenti realizzati da terzi, che restano di proprietà dei rispettivi titolari e sono regolati dalle rispettive licenze, le quali prevalgono sulle presenti Condizioni per quanto riguarda tali componenti.</li><li>I contenuti ai quali il Software consente di accedere, quali articoli giornalistici, video, trasmissioni radiofoniche e televisive, libri, audiolibri, dati meteorologici e voci enciclopediche, appartengono ai rispettivi titolari. L'Utente è tenuto a rispettarne i diritti e le condizioni d'uso.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 9 – Servizi di terzi e intelligenza artificiale", "<ol><li>Alcune funzioni del Software si basano su Servizi di terzi, sui quali l'Autore non esercita alcun controllo. L'uso di tali servizi è soggetto alle condizioni dei rispettivi fornitori, che l'Utente si impegna a rispettare, anche quando richiedono la creazione di account o l'uso di chiavi personali.</li><li>L'Autore non garantisce la disponibilità, la continuità, l'esattezza o la completezza dei Servizi di terzi e delle informazioni da essi fornite.</li><li>I contenuti prodotti dalle funzioni di intelligenza artificiale, quali risposte, riassunti, trascrizioni, bozze di messaggi e resoconti di notizie, sono generati in modo automatico, possono contenere errori o omissioni e devono essere verificati dall'Utente prima di qualsiasi utilizzo.</li><li>Le informazioni relative a farmaci, condizioni meteorologiche e luoghi hanno esclusivamente carattere informativo. Le informazioni sui farmaci non sostituiscono in alcun caso il parere del medico o del farmacista.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 10 – Aggiornamenti e assistenza", "<ol><li>L'Autore può rilasciare aggiornamenti che correggono, modificano, aggiungono o eliminano funzioni del Software. Gli aggiornamenti sono soggetti alle presenti Condizioni.</li><li>L'Autore non è tenuto a fornire aggiornamenti o assistenza e può sospendere o cessare in qualsiasi momento lo sviluppo o la distribuzione del Software.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 11 – Esclusione di garanzia", "<ol><li>Il Software è fornito gratuitamente, nello stato in cui si trova. Nei limiti consentiti dalla legge applicabile, l'Autore non presta alcuna garanzia, espressa o implicita, in merito all'assenza di errori, al funzionamento ininterrotto o all'idoneità del Software a scopi particolari.</li><li>Si raccomanda all'Utente di effettuare regolarmente copie di sicurezza dei propri dati.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 12 – Limitazione di responsabilità", "<ol><li>Nei limiti consentiti dalla legge applicabile, l'Autore non risponde dei danni, diretti o indiretti, derivanti dall'uso o dall'impossibilità di usare il Software, compresi la perdita di dati, i malfunzionamenti dei Servizi di terzi e le conseguenze dell'utilizzo dei contenuti generati dall'intelligenza artificiale.</li><li>La limitazione di cui al comma precedente non si applica ai danni derivanti da dolo o colpa grave dell'Autore né agli altri casi in cui la legge non consente di escludere o limitare la responsabilità, ai sensi dell'articolo 1229 del Codice civile.</li><li>Restano in ogni caso salvi i diritti riconosciuti ai consumatori dal Decreto Legislativo 6 settembre 2005, n. 206 (Codice del consumo).</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 13 – Durata e risoluzione", "<ol><li>Le presenti Condizioni si applicano a tempo indeterminato a decorrere dal momento dell'installazione o dell'utilizzo del Software.</li><li>La violazione dei termini della Licenza o delle presenti Condizioni comporta la caducazione automatica dei diritti concessi. In tal caso l'Utente deve cessare immediatamente ogni utilizzo del Software e distruggerne tutte le copie in suo possesso.</li><li>L'Autore si riserva la facoltà di interrompere in qualsiasi momento la pubblicazione del codice sorgente o di distribuire le versioni successive del Software con una licenza differente, anche di tipo chiuso. Le copie del codice sorgente già ricevute dall'Utente ai sensi della Licenza PolyForm restano liberamente utilizzabili nei limiti previsti da quest'ultima.</li><li>Restano salvaguardati i diritti dell'Autore ad agire nelle sedi competenti a tutela delle proprie ragioni e per il risarcimento dei danni.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 14 – Protezione dei dati personali", "<ol><li>Il trattamento dei dati personali connesso all'uso del Software e dei Siti ufficiali è descritto nella Privacy Policy pubblicata sul sito wingabriel.it, che costituisce parte integrante delle presenti Condizioni.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 15 – Modifiche alle Condizioni", "<ol><li>L'Autore si riserva il diritto di modificare in qualsiasi momento le presenti Condizioni d'uso e il regime di licenza per i rilasci futuri del Software. Le modifiche sono rese note mediante l'aggiornamento della data presente in Premessa.</li><li>Le Condizioni o le licenze modificate si applicano alle versioni del Software distribuite a partire dalla data di pubblicazione. L'installazione di aggiornamenti o di versioni successive a tale data costituisce accettazione delle nuove Condizioni.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 16 – Legge applicabile e foro competente", "<ol><li>Le presenti Condizioni sono regolate dalla legge italiana.</li><li>Per le controversie con Utenti che rivestono la qualifica di consumatori è competente in via esclusiva il foro del luogo di residenza o di domicilio del consumatore, ai sensi dell'articolo 66-bis del Codice del consumo.</li><li>Per ogni altra controversia è competente il foro del luogo di residenza dell'Autore.</li></ol>"))
            sezioni.Add(New SezioneDocumentoLegale("Articolo 17 – Disposizioni finali", "<ol><li>L'eventuale nullità o inefficacia di una clausola delle presenti Condizioni non comporta la nullità o l'inefficacia delle restanti clausole, che rimangono pienamente valide.</li><li>Il mancato esercizio da parte dell'Autore di un diritto previsto dalle presenti Condizioni non costituisce rinuncia allo stesso.</li><li>Le presenti Condizioni costituiscono l'intero accordo tra l'Autore e l'Utente in merito al Software e sostituiscono ogni precedente versione.</li></ol>"))
        Catch ex As Exception
