    Public Shared Function SezioniPrivacyPolicy() As List(Of SezioneDocumentoLegale)
        Dim sezioni As New List(Of SezioneDocumentoLegale)
        Try
            sezioni.Add(New SezioneDocumentoLegale("Premessa", "<p>Ultimo aggiornamento: 23 settembre 2026</p><p>La presente informativa descrive come vengono trattati i dati personali degli utenti dei siti <strong>wingabriel.it</strong> (sito principale) e <strong>wingabriel.net</strong> (servizio di aggiornamento) e del software <strong>WinGabriel</strong>, ai sensi del Regolamento (UE) 2016/679 (GDPR) e del D.Lgs. 196/2003 (Codice in materia di protezione dei dati personali), come modificato dal D.Lgs. 101/2018.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("1. Titolare del trattamento", "<p>Il Titolare del trattamento è:</p><p><strong>Gabriel Pappalardo</strong><br> Email di contatto: <a href=""mailto:gabriel.pappalardo@icloud.com"">gabriel.pappalardo@icloud.com</a></p><p>Il Titolare non ha nominato un Responsabile della protezione dei dati (DPO), non essendo tenuto a farlo ai sensi dell'art. 37 del GDPR.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("2. In sintesi", "<ul><li>WinGabriel non ha account utente, non contiene strumenti di statistica, profilazione o pubblicità e non invia al Titolare i dati che l'utente vi inserisce.</li><li>Agenda, rubrica, posta, area riservata, preferiti, cronologie e impostazioni sono salvati <strong>solo sul computer dell'utente</strong>.</li><li>Alcune funzioni si collegano a servizi di terzi. In quei casi i dati vanno <strong>direttamente</strong> dal computer dell'utente al servizio, senza passare dai server del Titolare, e il fornitore del servizio li tratta come titolare autonomo.</li><li>Il Titolare tratta direttamente soltanto i dati tecnici di connessione ai propri siti e al servizio di aggiornamento, e li conserva per 24 ore.</li></ul>"))
            sezioni.Add(New SezioneDocumentoLegale("3. Dati trattati dal Titolare", "<h3>3.1 Navigazione nei siti wingabriel.it e wingabriel.net</h3><ul><li><strong>Dati trattati:</strong> indirizzo IP, data e ora della richiesta, pagina o file richiesto, esito della richiesta, tipo di browser e sistema operativo, registrati automaticamente nei log del server.</li><li><strong>Finalità:</strong> funzionamento tecnico dei siti, sicurezza e prevenzione di abusi.</li><li><strong>Base giuridica:</strong> legittimo interesse del Titolare a garantire il funzionamento e la sicurezza dei siti (art. 6, par. 1, lett. f del GDPR).</li><li><strong>Conservazione:</strong> 24 ore, trascorse le quali i dati vengono cancellati. Possono essere conservati più a lungo soltanto i dati relativi a un attacco informatico o a un abuso in corso, per il tempo necessario ad accertarlo e a tutelare i diritti del Titolare, anche davanti alle autorità competenti.</li><li><strong>Cookie:</strong> i siti utilizzano soltanto cookie tecnici necessari al funzionamento, per i quali non è richiesto il consenso. Non sono utilizzati cookie di profilazione né strumenti di analisi o pubblicità di terze parti.</li></ul><h3>3.2 Aggiornamento del software</h3><ul><li><strong>Dati trattati:</strong> quando WinGabriel verifica o scarica gli aggiornamenti, il server di wingabriel.net riceve l'indirizzo IP del computer e i dati tecnici della richiesta, compresi i file richiesti e la versione installata.</li><li><strong>Finalità:</strong> distribuzione degli aggiornamenti e integrità del software.</li><li><strong>Base giuridica:</strong> esecuzione del servizio richiesto dall'utente con l'installazione del software e legittimo interesse del Titolare alla sicurezza della distribuzione (art. 6, par. 1, lett. b e f del GDPR).</li><li><strong>Conservazione:</strong> come per i log dei siti, al punto 3.1.</li></ul><h3>3.3 Contatti via email</h3><p>Se l'utente scrive al Titolare, l'indirizzo email e i dati contenuti nel messaggio sono usati solo per rispondere, sulla base della richiesta stessa dell'utente (art. 6, par. 1, lett. b del GDPR), e conservati per il tempo necessario a gestirla.</p><h3>3.4 Destinatari</h3><p>I dati descritti in questa sezione possono essere trattati dal fornitore di hosting dei siti, che opera come responsabile del trattamento ai sensi dell'art. 28 del GDPR. Non sono ceduti né comunicati a terzi per altre finalità.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("4. Dati salvati in locale dal software", "<p>WinGabriel memorizza sul computer dell'utente, nella cartella del programma o nella cartella dati scelta nelle impostazioni, le seguenti informazioni:</p><ul><li><strong>Agenda:</strong> appuntamenti, promemoria e relativi dati di sincronizzazione.</li><li><strong>Rubrica:</strong> contatti, ricerche recenti e relativi dati di sincronizzazione.</li><li><strong>Area riservata:</strong> i dati personali, anche sensibili, che l'utente sceglie di custodirvi, memorizzati in forma cifrata.</li><li><strong>Posta elettronica:</strong> messaggi, allegati, bozze, impostazioni degli account e credenziali di accesso ai server di posta.</li><li><strong>File e contenuti multimediali:</strong> file preferiti e recenti; video preferiti e recenti, ricerche preferite e recenti e iscrizioni ai canali YouTube.</li><li><strong>Quotidiani:</strong> testate aggiunte, preferite e recenti, categorie e stato di lettura degli articoli.</li><li><strong>Intelligenza artificiale:</strong> chiavi API inserite dall'utente e cronologia delle conversazioni.</li><li><strong>Altri dati di funzionamento:</strong> impostazioni, cronologie delle ricerche, stazioni radio e canali TV salvati, copie di backup create dall'utente.</li></ul><p>Questi dati non sono trasmessi al Titolare, che non vi ha accesso e non ne è titolare del trattamento: la loro conservazione, protezione e cancellazione sono gestite dall'utente, che può eliminarli in qualsiasi momento dal programma o disinstallandolo.</p><p>Se l'utente imposta come cartella dati una cartella sincronizzata con un servizio cloud (per esempio OneDrive), i dati vengono copiati anche su quel servizio, che li tratta secondo le proprie condizioni e la propria informativa.</p><p>Per la visualizzazione degli articoli dei quotidiani il software utilizza il componente Microsoft Edge WebView2, che può salvare in locale cookie e dati dei siti visitati, come farebbe un normale browser.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("5. Servizi di terzi utilizzati dal software", "<p>Le funzioni elencate di seguito si collegano a servizi di terzi soltanto quando l'utente le usa. I dati necessari sono inviati direttamente dal computer dell'utente ai server del fornitore. Il Titolare di WinGabriel non intercetta, non memorizza e non elabora tali dati, non agisce per conto dei fornitori e non li nomina propri responsabili: ciascun fornitore tratta i dati che riceve come <strong>titolare autonomo</strong>, secondo le proprie condizioni e la propria informativa, alle quali si rinvia.</p><p>I servizi sono di due tipi:</p><ul><li><strong>Servizi scelti dall'utente:</strong> il fornitore di posta, agenda e rubrica, i servizi di intelligenza artificiale e le testate giornalistiche. È l'utente a decidere se e quali usare, a configurarli con i propri account, chiavi o indirizzi e ad accettarne le condizioni. Il rapporto è diretto tra l'utente e il fornitore.</li><li><strong>Servizi integrati nel software:</strong> meteo e almanacco, biblioteche digitali, ricerca di luoghi, farmaci e farmacie, radio, televisione, Wikipedia e YouTube. Si tratta di servizi pubblici di consultazione, ai quali il software invia soltanto le richieste necessarie a mostrare le informazioni cercate dall'utente, senza account e senza dati identificativi diversi da quelli tecnici della connessione.</li></ul><h3>5.1 Posta elettronica, agenda e rubrica</h3><ul><li><strong>Dati inviati:</strong> credenziali dell'account, messaggi, allegati e destinatari; se l'utente attiva la sincronizzazione, anche appuntamenti e contatti; dati tecnici di connessione.</li><li><strong>Destinatario:</strong> il fornitore scelto e configurato dall'utente (per esempio iCloud), tramite i protocolli IMAP e SMTP per la posta, CalDAV per l'agenda e CardDAV per la rubrica.</li><li><strong>Informativa:</strong> quella del fornitore scelto dall'utente.</li></ul><h3>5.2 Intelligenza artificiale</h3><p>Le funzioni di intelligenza artificiale sono disponibili solo se l'utente inserisce una propria chiave API di Google Gemini o di Groq, ottenuta con un proprio account presso questi fornitori. Il rapporto con il fornitore è quindi diretto tra l'utente e il fornitore stesso.</p><p>A seconda della funzione usata, al fornitore vengono inviati:</p><ul><li><strong>Conversazioni:</strong> le domande dell'utente, la cronologia della conversazione e gli eventuali file allegati.</li><li><strong>Riassunti e descrizioni:</strong> il contenuto dei file, dei testi e delle immagini che l'utente sceglie di far riassumere o descrivere.</li><li><strong>Posta elettronica:</strong> quando l'utente chiede il riassunto di un messaggio o l'aiuto nella scrittura, il testo del messaggio con mittente, destinatari, oggetto e data, le indicazioni dell'utente ed eventualmente il testo già scritto. Il messaggio può contenere dati personali di terzi.</li><li><strong>Dettatura vocale e trascrizione di file audio:</strong> la registrazione della voce o il file audio da trascrivere.</li><li><strong>Video di YouTube:</strong> l'indirizzo del video da riassumere.</li><li><strong>Quotidiani e rassegna stampa personalizzata:</strong> il testo degli articoli da riassumere e i titoli e i nomi delle testate preferite dell'utente, da cui è possibile desumerne gli interessi.</li></ul><p>I fornitori sono:</p><ul><li><strong>Google Gemini API</strong>, fornito da Google. Con le chiavi del piano gratuito, secondo le condizioni aggiuntive di Google, i contenuti inviati e le risposte possono essere usati per migliorare i prodotti di Google e possono essere letti da revisori umani. Informative: <a href=""https://ai.google.dev/gemini-api/terms"" target=""_blank"" rel=""noopener"">Termini aggiuntivi della Gemini API</a> e <a href=""https://policies.google.com/privacy?hl=it"" target=""_blank"" rel=""noopener"">Informativa sulla privacy di Google</a>.</li><li><strong>Groq</strong>, fornito da Groq, Inc. (Stati Uniti). Informativa: <a href=""https://groq.com/privacy-policy/"" target=""_blank"" rel=""noopener"">Privacy Policy di Groq</a>.</li></ul><p>Si raccomanda di non inviare ai servizi di intelligenza artificiale dati appartenenti a categorie particolari (per esempio dati sulla salute) né dati di terzi senza che ve ne sia la necessità. Le risposte generate sono automatiche, possono contenere errori e vanno verificate dall'utente: WinGabriel non prende decisioni automatizzate che producano effetti giuridici sull'utente ai sensi dell'art. 22 del GDPR.</p><p>Le condizioni dei fornitori possono richiedere un'età minima per l'uso delle chiavi API: l'utente è tenuto a rispettarle.</p><h3>5.3 Quotidiani</h3><ul><li><strong>Dati inviati:</strong> richieste delle pagine, dei feed e degli articoli, con i dati tecnici di connessione.</li><li><strong>Destinatari:</strong> i siti delle testate aggiunte dall'utente, tramite le loro API WordPress, i feed RSS, le mappe dei siti o le pagine web. Le testate sono scelte e aggiunte dall'utente, e ciascuna è titolare autonoma dei dati che tratta quando l'utente ne consulta i contenuti, compresi i cookie salvati durante la consultazione.</li><li><strong>Estrazione del testo:</strong> avviene sul computer dell'utente, con il motore interno o con Trafilatura, eseguito in locale. Se l'utente sceglie Trafilatura, il software ne scarica i componenti (Python portatile e Trafilatura) dai rispettivi archivi ufficiali, che ricevono i dati tecnici della connessione.</li><li><strong>Informativa:</strong> quella di ciascuna testata consultata.</li></ul><h3>5.4 YouTube</h3><ul><li><strong>Dati inviati:</strong> termini di ricerca, identificativi dei video e dei canali, richieste di riproduzione e dati tecnici di connessione. Le iscrizioni ai canali sono gestite in locale leggendo i feed pubblici dei canali, senza accedere a un account Google.</li><li><strong>Destinatari:</strong> Google LLC / YouTube. Durante la riproduzione, per saltare le parti promozionali, il software può inviare l'identificativo del video al servizio SponsorBlock.</li><li><strong>Informativa:</strong><a href=""https://policies.google.com/privacy?hl=it"" target=""_blank"" rel=""noopener"">Informativa sulla privacy di Google</a>.</li></ul><h3>5.5 Wikipedia, Wikisource, Internet Archive e LibriVox</h3><ul><li><strong>Dati inviati:</strong> termini di ricerca, richieste di testi, audiolibri e file, dati tecnici di connessione.</li><li><strong>Destinatari:</strong> Wikimedia Foundation per Wikipedia e Wikisource; Internet Archive; il progetto LibriVox.</li><li><strong>Informative:</strong><a href=""https://foundation.wikimedia.org/wiki/Policy:Privacy_policy"" target=""_blank"" rel=""noopener"">Privacy Policy di Wikimedia Foundation</a>, <a href=""https://archive.org/about/terms"" target=""_blank"" rel=""noopener"">Termini e privacy di Internet Archive</a>, <a href=""https://librivox.org/"" target=""_blank"" rel=""noopener"">sito di LibriVox</a>.</li></ul><h3>5.6 Radio</h3><ul><li><strong>Dati inviati:</strong> richieste dell'elenco delle stazioni, termini di ricerca e dati tecnici di connessione; durante l'ascolto, i dati tecnici necessari allo streaming. Se l'utente segnala una nuova stazione, i dati della stazione inseriti dall'utente vengono inviati al servizio.</li><li><strong>Destinatari:</strong> il servizio comunitario Radio Browser (radio-browser.info), usato per raccogliere l'elenco delle radio, e le emittenti ascoltate.</li><li><strong>Informativa:</strong> quella di Radio Browser e delle singole emittenti.</li></ul><h3>5.7 Televisione</h3><ul><li><strong>Dati inviati:</strong> dati tecnici di connessione necessari a recuperare l'elenco dei canali e a riprodurre le trasmissioni in streaming.</li><li><strong>Destinatari:</strong> le emittenti televisive e le fonti pubbliche degli elenchi dei canali.</li><li><strong>Informativa:</strong> quella delle singole emittenti. Il Titolare non è responsabile delle pratiche sulla privacy dei broadcaster.</li></ul><h3>5.8 Meteo e almanacco</h3><ul><li><strong>Dati inviati:</strong> nome del comune o della località cercata, sue coordinate geografiche e dati tecnici di connessione. I comuni preferiti e recenti sono salvati solo in locale.</li><li><strong>Destinatari:</strong> Open-Meteo, per la ricerca delle località, le previsioni del tempo e le previsioni marine; Sunrise-Sunset (sunrisesunset.io), per gli orari di alba e tramonto dell'almanacco; Wikipedia in lingua italiana e Wikidata (Wikimedia Foundation), per gli eventi del giorno, le ricorrenze, i santi e gli onomastici. Le fasi lunari sono calcolate sul computer dell'utente.</li><li><strong>Informative:</strong><a href=""https://open-meteo.com/en/terms"" target=""_blank"" rel=""noopener"">Termini e privacy di Open-Meteo</a>, <a href=""https://sunrisesunset.io/"" target=""_blank"" rel=""noopener"">sito di Sunrise-Sunset</a>, <a href=""https://foundation.wikimedia.org/wiki/Policy:Privacy_policy"" target=""_blank"" rel=""noopener"">Privacy Policy di Wikimedia Foundation</a>.</li></ul><h3>5.9 Ricerca di luoghi</h3><ul><li><strong>Dati inviati:</strong> luoghi e termini di ricerca geografica, dati tecnici di connessione.</li><li><strong>Destinatari:</strong> OpenStreetMap Foundation, i fornitori dei dati Overture Maps e Wikidata (Wikimedia Foundation).</li><li><strong>Informative:</strong><a href=""https://osmfoundation.org/wiki/Privacy_Policy"" target=""_blank"" rel=""noopener"">Privacy Policy di OpenStreetMap Foundation</a>, <a href=""https://foundation.wikimedia.org/wiki/Policy:Privacy_policy"" target=""_blank"" rel=""noopener"">Privacy Policy di Wikimedia Foundation</a>; per Overture Maps, le informative disponibili sul sito del progetto.</li></ul><h3>5.10 Farmaci e farmacie</h3><ul><li><strong>Funzionamento:</strong> la ricerca e la consultazione dei farmaci avvengono interamente in locale, su una banca dati costruita con i dati aperti pubblicati da AIFA. Nessuna ricerca viene inviata a server esterni.</li><li><strong>Dati inviati:</strong> per scaricare e aggiornare la banca dati e i fogli illustrativi, e per la ricerca delle farmacie, il software si collega alle fonti pubbliche dei dati, che ricevono i dati tecnici di connessione e, per la ricerca delle farmacie, la località indicata.</li></ul>"))
            sezioni.Add(New SezioneDocumentoLegale("6. Trasferimento dei dati fuori dall'Unione Europea", "<p>Alcuni fornitori di servizi di terzi (per esempio Google, Groq o il fornitore di posta scelto dall'utente) hanno sede o server negli Stati Uniti o in altri Paesi al di fuori dello Spazio Economico Europeo. In questi casi il trasferimento avviene direttamente tra l'utente e il fornitore, sulla base delle garanzie indicate nelle rispettive informative, come la decisione di adeguatezza sul Data Privacy Framework UE-USA per i fornitori certificati o le Clausole Contrattuali Standard approvate dalla Commissione Europea.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("7. Uso personale del software e dati di terzi", "<p>WinGabriel è destinato all'uso personale. Il trattamento di dati di altre persone da parte dell'utente (contatti della rubrica, messaggi di posta, appuntamenti) per finalità esclusivamente personali o domestiche non rientra nell'ambito del GDPR, ai sensi dell'art. 2, par. 2, lett. c. Se l'utente utilizza il software per attività professionali, è lui il titolare del trattamento dei dati di terzi che gestisce, compresi quelli inviati ai servizi di intelligenza artificiale, e deve valutarne la liceità.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("8. Minori", "<p>I siti e il software non sono rivolti in modo specifico ai minori e il Titolare non raccoglie consapevolmente dati personali di minori. L'uso dei servizi di terzi da parte di minori è soggetto ai limiti di età previsti dai rispettivi fornitori e, in Italia, dall'art. 2-quinquies del D.Lgs. 196/2003.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("9. Diritti dell'interessato", "<p>Per i dati trattati dal Titolare (sezione 3), l'utente può esercitare in qualsiasi momento, scrivendo all'indirizzo email indicato al punto 1, i seguenti diritti:</p><ul><li><strong>Accesso (art. 15 GDPR):</strong> ottenere conferma che sia in corso un trattamento di dati che lo riguardano e ottenerne copia.</li><li><strong>Rettifica (art. 16 GDPR):</strong> correggere dati inesatti o integrare dati incompleti.</li><li><strong>Cancellazione (art. 17 GDPR):</strong> ottenere la cancellazione dei dati nei casi previsti.</li><li><strong>Limitazione (art. 18 GDPR):</strong> ottenere la limitazione del trattamento nei casi previsti.</li><li><strong>Portabilità (art. 20 GDPR):</strong> ricevere i dati in un formato strutturato e leggibile da dispositivo automatico, nei casi previsti.</li><li><strong>Opposizione (art. 21 GDPR):</strong> opporsi al trattamento basato sul legittimo interesse, per motivi connessi alla propria situazione particolare.</li><li><strong>Reclamo (art. 77 GDPR):</strong> proporre reclamo al Garante per la protezione dei dati personali (<a href=""https://www.garanteprivacy.it"" target=""_blank"" rel=""noopener"">www.garanteprivacy.it</a>) o all'autorità di controllo dello Stato in cui l'utente risiede o lavora.</li></ul><p>Il Titolare risponde entro un mese dalla richiesta, termine prorogabile nei casi previsti dall'art. 12 del GDPR. Per i dati salvati in locale (sezione 4) l'utente ha già il pieno controllo e non occorre alcuna richiesta. Per i dati trattati dai servizi di terzi (sezione 5) i diritti vanno esercitati direttamente presso i rispettivi fornitori.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("10. Sicurezza", "<p>Il Titolare adotta misure tecniche e organizzative adeguate, ai sensi dell'art. 32 del GDPR, per proteggere i siti, il servizio di aggiornamento e l'integrità del software distribuito. Le connessioni ai servizi di terzi avvengono, dove il servizio lo consente, tramite protocolli cifrati. La sicurezza dei dati salvati sul computer dell'utente dipende anche dalla protezione del computer stesso: si consiglia di proteggere l'accesso al sistema con una password e di custodire con cura le copie di backup.</p>"))
            sezioni.Add(New SezioneDocumentoLegale("11. Modifiche a questa informativa", "<p>Il Titolare può aggiornare la presente informativa per adeguarla a modifiche normative, del software o dei servizi collegati. Le modifiche sono pubblicate in questa pagina con la data dell'ultimo aggiornamento, che si invita a consultare periodicamente.</p>"))
        Catch ex As Exception
            Dim registro As New Logger()
            registro.ScriviLog("DocumentiLegaliWinGabriel.SezioniPrivacyPolicy: " & ex.Message & Environment.NewLine & ex.StackTrace)
