      <Project>{54A254AC-FF36-4CB6-9932-E39BE2FF576A}</Project>
      <Name>WGLettoreSchermo</Name>
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- Il componente si copia nella cartella "moduli" accanto al lettore: da lì il lettore lo carica. -->
  <Target Name="CopiaNeiModuli" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\..\WGLettore\bin\$(Configuration)\moduli" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\WGLettore\bin\$(Configuration)\moduli" />
  </Target>
</Project>
